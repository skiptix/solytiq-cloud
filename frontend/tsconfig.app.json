{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    /* `@/*` alias used only by the vendored src/components/animate-ui tree
       (kept as shadcn/Animate UI upstream sources expect it). Deliberately
       `paths` WITHOUT `baseUrl` — TypeScript 6 deprecates bare `baseUrl`
       (see https://aka.ms/ts6); `paths` alone resolves relative to this
       tsconfig file under "moduleResolution": "bundler", which is what Vite's
       resolver also does via the alias below, so no baseUrl is needed. */
    "paths": { "@/*": ["./src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
