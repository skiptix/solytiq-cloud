# ────────────────────────────────────────────────────────────────
# Solytiq Cloud — Environment Variables
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=solytiq
POSTGRES_USER=solytiq
POSTGRES_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend
FRONTEND_URL=http://localhost

# Port (host port for the frontend container)
PORT=80


# Ai Assistant
OPENROUTER_MODEL=
OPENROUTER_API_KEY=

# Knowledge Layer — semantic search over notes/pages/milestones/meetings.
# Falls back to OPENROUTER_API_KEY if EMBEDDING_API_KEY is unset. Requires the
# `vector` Postgres extension (see docker-compose.yml's pgvector image) —
# without it, search still works lexical-only (trigram), just no embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Email Notifications (Resend) — the API key/sender itself is configured from
# Settings → Email in the admin UI, not here. This is only an optional key
# for encrypting that API key at rest; falls back to a key derived from
# JWT_SECRET when unset.
RESEND_ENCRYPTION_KEY=
