# ────────────────────────────────────────────────────────────────
# Solytiq Cloud — Environment Variables
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=solytiq
POSTGRES_USER=solytiq
POSTGRES_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend
FRONTEND_URL=http://localhost

# Port (host port for the frontend container)
PORT=80


# Ai Assistant
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
