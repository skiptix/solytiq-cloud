{
  "name": "solytiq-cloud-backend",
  "version": "1.0.0",
  "description": "Solytiq Cloud backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.perf.test.ts\"",
    "test:integration": "vitest run --no-file-parallelism --passWithNoTests .integration.test.ts",
    "test:performance": "vitest run --no-file-parallelism --passWithNoTests --testTimeout=300000 --hookTimeout=600000 .perf.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/multer": "^2.1.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.0.0",
    "fit-file-parser": "^1.9.0",
    "helmet": "^8.2.0",
    "ipaddr.js": "^2.4.0",
    "isolated-vm": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "multer": "^2.1.1",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "qrcode": "^1.5.3",
    "resend": "^6.19.0",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.8"
  }
}
